<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <tradetracker>
            <general>
                <enable>1</enable>
                <debug>1</debug>
                <batch_size>10000</batch_size>
                <preview_size>5000</preview_size>
            </general>
            <direct_linking>
                <enable>0</enable>
                <url_key>tradetracker-redirect</url_key>
            </direct_linking>
            <feeds>
                <results></results>
            </feeds>
            <advanced>
                <enable_multi_country>0</enable_multi_country>
            </advanced>
            <pixel>
                <enable>0</enable>
                <overwrite_currency>0</overwrite_currency>
            </pixel>
            <feed>
                <enable>0</enable>
                <cron_frequency>0 0 * * *</cron_frequency>
                <filename>tradetracker.xml</filename>
                <name_attribute>name</name_attribute>
                <description_attribute>short_description</description_attribute>
                <description_long_attribute>description</description_long_attribute>
                <image>image</image>
                <brand_attribute>manufacturer</brand_attribute>
                <color_attribute>color</color_attribute>
                <size_attribute>size</size_attribute>
                <gender_attribute>gender</gender_attribute>
                <configurable>simple</configurable>
                <configurable_link>1</configurable_link>
                <configurable_image>2</configurable_image>
                <configurable_parent_atts>description</configurable_parent_atts>
                <configurable_nonvisible>1</configurable_nonvisible>
                <bundle>parent</bundle>
                <bundle_nonvisible>0</bundle_nonvisible>
                <grouped>parent</grouped>
                <grouped_nonvisible>0</grouped_nonvisible>
                <delivery_source>static</delivery_source>
                <filter_visbility>0</filter_visbility>
                <filter_category>0</filter_category>
                <filter_type_category>in</filter_type_category>
                <filter_stock>0</filter_stock>
                <custom_filters>0</custom_filters>
                <vat_pct_enabled>0</vat_pct_enabled>
                <vat_pct_source>static</vat_pct_source>
                <vat_pct_static>21</vat_pct_static>
            </feed>
        </tradetracker>
    </default>
</config>
