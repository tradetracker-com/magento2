?>
<?php if ($feedData = $block->getStoreData()): ?>
    <div class="block-tradetracker-feeds">
        <span class="title"><?= $block->escapeHtml(__('Feeds')) ?></span>
        <?= /* @noEscape */ (string)__('All active feeds are shown in the overview below.<br>') ?>
        <?= /* @noEscape */ (string)__('Copy the .XML URL into your TradeTracker account.') ?>
        <?= /* @noEscape */ (string)__('Download the feed to see the latest version; a browser may cache it.') ?>
        <br><br>
        <?= /* @noEscape */ (string)__('<strong>Note:</strong> Save the configuration before you generate the feed.') ?>
        <table class="block-tradetracker-feeds-table">
            <tbody>
            <?php foreach ($feedData as $data): ?>
                <tr data-role="tt-feed-row"
                    data-progress-url="<?= $block->escapeUrl($data['progress_url']); ?>">
                    <td>
                        <p><?= $block->escapeHtml($data['name']); ?></p>
                        <p>
                            <small><?= $block->escapeHtml($data['code']); ?></small>
                        </p>
                    </td>
                    <td>
                        <?php if (!empty($data['url']) && $data['available']): ?>
                            <p>
                                <a href="<?= $block->escapeUrl($data['url']); ?>" target="_blank">
                                    <?= $block->escapeUrl($data['url']); ?>
                                </a>
                            </p>
                            <p>
                                <small><?= $block->escapeHtml($data['result']); ?></small>
                            </p>
                        <?php else: ?>
                            <p>
                                <?= $block->escapeUrl($data['url']); ?>
                            </p>
                            <p>
                                <small>
                                    <?= $block->escapeHtml(__('Feed not available, please generate the Feed first.')) ?>
                                </small>
                            </p>
                        <?php endif; ?>
                    </td>
                    <td>
                        <?php if (!empty($data['status'])): ?>
                            <p>
                                <a class="generate"
                                   href="<?= $block->escapeUrl($data['generate_url']); ?>"
                                   data-ajax-url="<?= $block->escapeUrl($data['ajax_generate_url']); ?>">Generate</a>
                            </p>
                            <div class="tt-feed-progress" data-role="tt-feed-progress" style="display: none;">
                                <span data-role="tt-feed-progress-label"></span>
                                <div class="tt-feed-progress__track">
                                    <div class="tt-feed-progress__bar" data-role="tt-feed-progress-bar"></div>
                                </div>
                            </div>
                            <p>
                                <a class="preview"
                                   href="<?= $block->escapeUrl($data['preview_url']); ?>"
                                   target="_blank">Preview</a>
                            </p>
                            <p>
                                <?php if (!empty($data['path']) && $data['available']): ?>
                                    <a class="download"
                                       href="<?= $block->escapeUrl($data['download_url']); ?>">Download</a>
                                <?php endif; ?>
                            </p>
                        <?php else: ?>
                            <p class="enable">
                                <?= $block->escapeHtml(__('Module Disabled.')) ?>
                                <small>
                                    <br
                                    <?= $block->escapeHtml(__('Enabled Feed and General Module.')) ?>
                                </small>
                            </p>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    </div>
    <script type="text/x-magento-init">
        {
            ".block-tradetracker-feeds-table": {
                "TradeTracker_Connect/js/feed-progress": {
                    "formKey": "<?= $block->escapeJs($block->getFormKey()); ?>"
                }
            }
        }
    </script>
<?php endif; ?>
