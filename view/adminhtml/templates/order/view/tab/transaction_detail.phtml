use Magento\Framework\Escaper;
use TradeTracker\Connect\Block\Adminhtml\Order\View\Transaction;

/** @var Transaction $block */
/** @var Escaper $escaper */

$transaction = $block->getTransaction();
$rows = [];
if (isset($transaction['data'])) {
    $data = $transaction['data'];
    $rows = [
        'Conversion Date' => (string)($data->registrationDate ?? ''),
        'Campaign ID' => (string)($data->campaign->ID ?? ''),
        'Transaction ID' => (string)($data->ID ?? ''),
        'Transaction Amount' => (string)($data->orderAmount ?? ''),
        'Currency' => (string)($data->currency ?? ''),
        'Status' => (string)($data->transactionStatus ?? ''),
    ];
}
?>
<div class="fieldset-wrapper customer-information tradetracker-transaction">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('TradeTracker Conversion')) ?></span>
    </div>
    <div>
        <?php if ($rows !== []): ?>
            <table class="admin__table-secondary" style="width: 500px;">
                <tbody>
                <?php foreach ($rows as $label => $value): ?>
                    <tr>
                        <th style="width: 200px;"><?= $escaper->escapeHtml(__($label)) ?></th>
                        <td><?= $escaper->escapeHtml($value) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php else: ?>
            <p class="tradetracker-transaction-message"><?= $escaper->escapeHtml($transaction['error'] ?? '') ?></p>
        <?php endif; ?>
    </div>
</div>
